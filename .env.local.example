# EmailJS — create a free account at https://www.emailjs.com
# Dashboard → Email Services → add Gmail/Outlook → copy Service ID
# Dashboard → Email Templates → create template → copy Template ID
# Dashboard → Account → General → copy Public Key
#
# Template variables used by the site:
#   {{from_name}} {{last_name}} {{phone}} {{email}}
#   {{organization}} {{country}} {{message}}
#   {{page_url}} {{page_path}} {{page_label}}
#   {{button_label}} {{form_source}}
# {{form_source}} example:
#   Popup form | Page: Home (/) | Button: Request a Free Demo

NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# Cloudinary — Dashboard → Settings → API Keys
# Used by: npm run images:cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=albatroz
